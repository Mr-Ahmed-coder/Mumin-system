PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE_NAME?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_at_least_16_characters
JWT_REFRESH_SECRET=replace_with_at_least_16_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated exact frontend origins; never use * with credentialed requests.
CORS_ORIGIN=http://localhost:3000

# Set to true for preview/staging demo deployments (enables ledger workflows in non-dev environments).
DEMO_MODE=false
ENABLE_DEV_RESET=false

# Optional during normal startup. Required only when manually running `npm run seed:admin`.
# Never commit real credentials or leave ADMIN_PASSWORD configured after bootstrapping.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# Optional development-only seed/test credentials.
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
# DEV_CASHIER_EMAIL=
# DEV_CASHIER_PASSWORD=
